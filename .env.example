# Chỉ giá trị public ở biến VITE_*. Không đặt secret Supabase ở frontend.

# Trình duyệt gọi API: để trống khi dev (Vite proxy /api) và khi nginx cùng origin.
VITE_API_BASE_URL=

# Server Node (SSR) gọi API trực tiếp, không qua trình duyệt.
API_URL=http://localhost:5179

# URL công khai của site, dùng cho og:url và canonical.
SITE_URL=http://localhost:5173
